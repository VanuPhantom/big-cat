{
  "name": "big-cat",
  "version": "0.1.0",
  "description": "A GIT log sidebar for the OpenCode 2 TUI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui/index.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p test/e2e",
    "test": "npm run test:watchers && npm run test:e2e",
    "test:watchers": "tsc --noEmit false --outDir .big-cat-test && node --test test/*.test.mjs",
    "test:e2e": "bun test --timeout 20000"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "git",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
